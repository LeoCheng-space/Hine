# Shared by compose.acceptance.yml (disposable acceptance runs) and compose.local.yml (./build.sh local stack).
# Routing changes here affect both; production uses infra/docker/Caddyfile.
{
	admin off
	auto_https disable_redirects
}

{$HINE_DOMAIN} {
	tls internal
	root * /srv/hine
	# Keep identical to the production Caddyfile security headers (SEC-07); the native acceptance Caddy copies it.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self' https://storage.googleapis.com; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
	}
	route {
		@private path /internal /internal/* /health /health/*
		handle @private {
			respond "Not found" 404
		}
		@api path /api/v1 /api/v1/*
		handle @api {
			reverse_proxy api:8080 {
				header_up X-Hine-Client-IP {remote_host}
			}
		}
		@websocket path /ws/v1
		handle @websocket {
			reverse_proxy realtime:8081
		}
		@reserved path /api /api/* /ws /ws/*
		handle @reserved {
			respond "Not found" 404
		}
		@spa path_regexp spa ^/(login|register|contacts|chats|profile|chats/[^/]+|groups/[^/]+/manage)?$
		handle @spa {
			rewrite * /index.html
			file_server
		}
		handle {
			file_server
		}
	}
}
