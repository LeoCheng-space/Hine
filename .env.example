# Non-secret development configuration. Copy via sh infra/scripts/init-dev.sh.
# Keep the project name stable: it identifies existing persistent volumes.
COMPOSE_PROJECT_NAME=hine-dev
HINE_ENV=development
HINE_SECRET_DIR=.secrets
POSTGRES_DB=hine
POSTGRES_USER=hine
PUBLIC_ORIGIN=https://hine.run.place
API_INTERNAL_URL=http://api:8080

# init-dev.sh replaces these IDs in a newly generated .env with the actual BA
# secret-file owner. Existing .env files are never rewritten; verify their IDs.
HINE_RUNTIME_UID=0
HINE_RUNTIME_GID=0

# Production requires real, owner-supplied artifacts; these are intentionally unset.
# Do not set provider/image placeholders or run production against the dev DB.
# API_PROVIDER_COMPOSE=/absolute/path/to/approved-api.compose.yml
# WEB_ROOT=/absolute/path/to/the/approved-web-build
# HINE_DOMAIN=hine.run.place
# ACME_EMAIL=operator@example.org
