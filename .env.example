# Non-secret development configuration. Copy via sh infra/scripts/init-dev.sh.
# Keep the project name stable: it identifies existing persistent volumes.
COMPOSE_PROJECT_NAME=hine-dev
HINE_ENV=development
HINE_SECRET_DIR=.secrets
POSTGRES_DB=hine
POSTGRES_USER=hine
PUBLIC_ORIGIN=https://hine.run.place
API_INTERNAL_URL=http://api:8080
REALTIME_INTERNAL_URL=http://realtime:8081
JWT_ISSUER=hine
JWT_AUDIENCE=hine-web
INVALIDATION_RETENTION_SECONDS=900
GCS_BUCKET=
# No forwarded IP is trusted by default. Production requires actual proxy CIDRs.
TRUSTED_PROXY_NETWORKS=
GCS_PROJECT=
GCS_SIGNING_SERVICE_ACCOUNT=

# init-dev.sh replaces these IDs in a newly generated .env with the actual BA
# secret-file owner. Existing .env files are never rewritten; verify their IDs.
HINE_RUNTIME_UID=0
HINE_RUNTIME_GID=0

# Production uses the bundled api image and a real frontend build.
# Keep production secrets/data separate from the development database.
# WEB_ROOT=/absolute/path/to/frontend/app/dist
# HINE_DOMAIN=hine.run.place
# ACME_EMAIL=operator@example.org
